# Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# SANITY CONFIGURATION (Required)
# ============================================

# Your Sanity project ID (from sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# API version (use today's date for latest features)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ============================================
# PREVIEW & DRAFT MODE (Required for preview)
# ============================================

# Sanity API token with Viewer permissions
# Create at: sanity.io/manage → API → Tokens → Add API token
# Permission: Viewer (read-only access to drafts)
SANITY_API_READ_TOKEN=

# Shared secret for preview URL validation
# Generate a random string (32+ characters recommended)
# Must match the secret configured in Sanity Studio
SANITY_PREVIEW_SECRET=

# ============================================
# WEBHOOKS (Required for on-demand revalidation)
# ============================================

# Secret for webhook validation
# Generate a random string (32+ characters recommended)
# Used when setting up Sanity webhook
SANITY_WEBHOOK_SECRET=

# ============================================
# OPTIONAL
# ============================================

# Sanity Studio URL (for admin links in frontend)
# SANITY_STUDIO_URL=https://your-studio.sanity.studio
